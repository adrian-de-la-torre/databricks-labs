# Terraform state — never committed. Holds every resource attribute in plaintext.
*.tfstate
*.tfstate.*
.terraform/
.terraform.tfstate.lock.info
crash.log
crash.*.log
tfplan
*.tfplan

# envs/*.tfvars and envs/*.tfbackend ARE committed on purpose: they are the
# deployment coordinates of this platform and hold no secrets. Only locally
# auto-loaded overrides are ignored.
*.auto.tfvars
override.tf
override.tf.json
*_override.tf

# Databricks
.databricks/
.databrickscfg

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Credentials
.env
*.pem
*.key

# macOS
.DS_Store

# The agent configuration this repository declares is committed; the per-machine
# override is not. settings.local.json is where anything non-Anthropic would live,
# and it must never reach a public repository.
.claude/settings.local.json

# Editor and tooling backups. One reached a commit because two agents edited
# this repository at the same time; the fix is to make it unstageable.
*.bak
*.orig
