# The gate, defined once. CI runs `pre-commit run --all-files`, so what blocks a
# commit locally and what blocks a pull request are the same thing by construction.
repos:
  - repo: https://github.com/antonbabenko/pre-commit-terraform
    rev: v1.109.1
    hooks:
      - id: terraform_fmt
      - id: terraform_validate
        args: [--tf-init-args=-backend=false]
      - id: terraform_tflint
        args: [--args=--config=__GIT_WORKING_DIR__/.tflint.hcl]

  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: end-of-file-fixer
      - id: trailing-whitespace
      - id: check-merge-conflict
      - id: check-yaml

  - repo: local
    hooks:
      # State files hold every resource attribute in plaintext. This is the
      # realistic leak in a Terraform repository, and .gitignore only helps
      # until someone uses `git add -f`.
      - id: no-state-files
        name: refuse Terraform state and local credentials
        entry: refused - this path must never be committed
        language: fail
        files: '(\.tfstate|\.tfstate\.backup|\.auto\.tfvars|\.databrickscfg)$'

      # A charset check would not work: the Spanish this repository started from
      # was written without accents and is pure ASCII. Only a wordlist catches it.
      - id: english-only
        name: refuse Spanish in committed files
        entry: bash -c 'if grep -rilE "\b(para|pero|porque|cuando|desde|entorno|cuenta|fichero|red|nombre|siguiente|cada|este|esta|esto|donde|hace|tiene|debe|puede)\b" "$@" 2>/dev/null | grep -q .; then echo "Spanish detected in:"; grep -rilE "\b(para|pero|porque|cuando|desde|entorno|cuenta|fichero|red|nombre|siguiente|cada|este|esta|esto|donde|hace|tiene|debe|puede)\b" "$@"; exit 1; fi' --
        language: system
        types_or: [markdown, terraform, shell, yaml]
        # This file is the only legitimate place Spanish appears: it is the
        # wordlist. Without the exclusion the hook matches itself, which it
        # promptly did the first time it ran.
        exclude: '^\.pre-commit-config\.yaml$'
